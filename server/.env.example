# Server Configuration
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/linkora

# Session Security
SESSION_SECRET=your_super_secret_session_key_here

# Google OAuth 2.0 Credentials (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Phase 11: Gmail Outreach OAuth 2.0 Callback URL
# Development default: http://localhost:5002/api/outreach/connect/google/callback
# Production example: https://api.yourdomain.com/api/outreach/connect/google/callback
GOOGLE_GMAIL_CALLBACK_URL=http://localhost:5002/api/outreach/connect/google/callback

# Active SEO Data Provider: 'moz' or 'dataforseo' (default: moz)
SEO_PROVIDER=moz

# SEO Provider 1: Moz API v2 (Current Active Provider)
# Register at https://moz.com/api/dashboard to generate your API token
# Free community plan: 1 request / 10s, monthly row allowance
MOZ_API_TOKEN=your_moz_api_token_here

# SEO Provider 2: DataForSEO (Preserved for future funded use)
# Register at https://app.dataforseo.com/register for API credentials
# Pay-per-request model (~$0.02 to $0.05 per Live summary call)
DATAFORSEO_LOGIN=your_dataforseo_api_login_here
DATAFORSEO_PASSWORD=your_dataforseo_api_password_here
